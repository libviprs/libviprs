    "save_trap": {
      "what": "`vips radsave` on an image that is not already VIPS_CODING_RAD routes through vips_colourspace(-> sRGB) and clips to uchar, so the only HDR-preserving save path in vips is float2rad THEN radsave. libviprs's save_radiance is equivalent to the pair, which means libviprs round-trips high dynamic range where a bare `vips radsave` does not. That is a deliberate divergence.",
      "image": "sample.hdr 141x980",
      "values": {
        "original": {
          "max": 7728.0,
          "avg": 51.784629
        },
        "radsave_alone": {
          "max": 254.5,
          "avg": 228.068244
        },
        "float2rad_then_radsave": {
          "max": 7728.0,
          "avg": 51.784629
        }
      }
    },
